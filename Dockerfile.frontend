FROM node:22 AS build
WORKDIR /app

COPY package.json ./
COPY packages/domain/package.json packages/domain/package.json
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
# No package-lock.json, and `--install-strategy=nested`, not `ci`/default
# hoisted install:
# 1. The real lockfile was generated on Windows and (npm/cli#4828) doesn't
#    carry rolldown's Linux native binding at all — `npm ci` fails on any
#    Linux target no matter which libc. Only a from-scratch resolution
#    picks up the right one for wherever this actually builds.
# 2. Default hoisting hoists cesium to the workspace root, but
#    vite-plugin-cesium looks for node_modules/cesium relative to the
#    frontend workspace itself and fails to find it there — `nested` keeps
#    every workspace's deps local to it, matching how it's laid out on a
#    normal (non-Docker) `npm install` outside this monorepo's root.
RUN npm install --install-strategy=nested

COPY packages/domain packages/domain
COPY frontend frontend

# Baked in at build time (Vite inlines import.meta.env.* into the bundle) —
# VITE_API_BASE_URL is deliberately empty: nginx proxies /api/ to the
# backend container under the same origin, so the frontend calls itself
# with relative paths instead of needing a second CORS-exposed origin.
ARG VITE_CESIUM_ION_TOKEN=
RUN echo "VITE_API_BASE_URL=" > /app/frontend/.env.production.local \
 && echo "VITE_CESIUM_ION_TOKEN=${VITE_CESIUM_ION_TOKEN}" >> /app/frontend/.env.production.local

WORKDIR /app/frontend
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
