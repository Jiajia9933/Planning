# Copy this to `.env` on the EC2 host (same directory as docker-compose.prod.yml)
# and fill in real values. `.env` is gitignored — never commit it.

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# The one public URL colleagues will use, e.g. http://<ec2-public-ip>
# (or https://your-temp-domain once you put a real domain in front of it).
PUBLIC_ORIGIN=

# Same Ion token already used in frontend/.env.local for local dev.
VITE_CESIUM_ION_TOKEN=

# Optional — forgot-password emails. Leave RESEND_API_KEY empty to skip
# sending (the backend just logs the reset link instead of erroring).
# With onboarding@resend.dev, Resend only delivers to the account owner's
# own email until a domain is verified at resend.com/domains — fine for a
# short demo, not for colleagues resetting their own passwords.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
